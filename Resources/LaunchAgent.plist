<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- 0.8.43 registered this with SMAppService.agent to start the app at login and after a
     crash. launchd refuses an agent once a self-signed app is replaced by an update, so it is
     no longer registered: it stays in the app (Contents/Library/LaunchAgents) only so that
     LoginItem.settle can unregister it on Macs that ran 0.8.43. -->
<dict>
    <key>Label</key>
    <string>consulting.cloudscale.systemsentinel.agent</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/SystemSentinel</string>
    <key>ProgramArguments</key>
    <array>
        <string>Contents/MacOS/SystemSentinel</string>
        <string>--background</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>consulting.cloudscale.systemsentinel</string>
    </array>
</dict>
</plist>
